# Banco de dados PostgreSQL (Supabase).
#
# DATABASE_URL  -> conexão usada em runtime pela aplicação (Prisma Client).
#   Use a conexão POOLED do Supabase (Transaction mode, porta 6543) com pgbouncer.
#   Em serverless (Vercel) isto é obrigatório para não esgotar conexões.
#   Ex.: postgresql://postgres.<ref>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#
# DIRECT_URL    -> conexão DIRETA (porta 5432), usada por migrations/seed/import.
#   Ex.: postgresql://postgres.<ref>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
#
# As duas strings ficam em Supabase > Settings > Database > Connection string.
#
# ATENÇÃO no DESENVOLVIMENTO LOCAL: na rede da Zucchi a porta 6543 está
# BLOQUEADA, então o DATABASE_URL de produção não conecta e todas as páginas
# caem em "dados indisponíveis". Localmente aponte o DATABASE_URL para a mesma
# URL do DIRECT_URL (porta 5432) com ?connection_limit=8. Na Vercel mantenha
# 6543. Detalhes e medições em docs/performance-conexoes-banco.md.
DATABASE_URL="postgresql://postgres.<ref>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:5432/postgres"

# Segredo de assinatura da sessão (HMAC-SHA256). OBRIGATÓRIO — sem ele, ninguém loga.
# Use um valor aleatório com pelo menos 16 caracteres (recomendado 32 bytes).
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="<gere-um-segredo-aleatorio>"

# Fallback de login admin/admin123 — APENAS desenvolvimento. Nunca usar em produção.
# Só funciona quando ALLOW_AUTH_FALLBACK=true E NODE_ENV != production.
# ALLOW_AUTH_FALLBACK="true"

# Supabase Storage — anexos do módulo Equipe, materiais de Procedimentos e
# planilhas de importação.
# Bucket PRIVADO "collaborator-attachments". O upload e a geração de URL assinada
# acontecem SOMENTE no servidor; a SERVICE ROLE KEY nunca pode ir ao cliente.
# Configure as duas variáveis no .env local E nas env vars da Vercel.
#   SUPABASE_URL              -> Project URL (Supabase > Settings > API).
#   SUPABASE_SERVICE_ROLE_KEY -> chave "service_role" (SECRETA — nunca commitar).
# Sem elas, o portal funciona normalmente, mas o upload/download de anexos
# responde 503 ("armazenamento não configurado").
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key-secreta>"

# ---------------------------------------------------------------------------
# Supabase Storage — IMPORTAÇÕES (bucket privado das planilhas)
# ---------------------------------------------------------------------------
# Bucket PRIVADO onde fica a planilha original de cada importação (PC-Factory,
# Compras, Ordens de Serviço, Lubrificantes, Locais de Instalação,
# Procedimentos). É o que permite responder depois "de que arquivo exatamente
# saíram estes números?". Estrutura das chaves:
#   imports/<modulo>/<ano>/<mes>/<timestamp>-<nome-do-arquivo>
#
# Criar uma vez com:  npm run storage:setup-imports
# Opcional — sem ela o padrão é "portal-imports".
# SUPABASE_STORAGE_BUCKET_IMPORTS="portal-imports"

# Teto do arquivo de importação, em BYTES. Opcional — padrão 25 MB.
# NÃO confundir com o limite da função serverless da Vercel (~4,5 MB de corpo):
# este é o teto do objeto no Storage, usado no upload direto navegador → bucket.
# SUPABASE_IMPORT_MAX_BYTES="26214400"

# ---------------------------------------------------------------------------
# Aliases NEXT_PUBLIC_* — OPCIONAIS, só por compatibilidade
# ---------------------------------------------------------------------------
# O portal NÃO usa cliente Supabase no navegador: nenhuma tela importa
# @supabase/supabase-js diretamente. Estas variáveis existem apenas porque o
# padrão do ecossistema Supabase usa o prefixo NEXT_PUBLIC_, e o código aceita
# os dois nomes (SUPABASE_URL tem precedência).
#
# ATENÇÃO: tudo que começa com NEXT_PUBLIC_ é INLINADO no bundle do navegador
# pelo Next. Só pode receber esse prefixo o que é público por design.
# JAMAIS criar NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY.
# NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key-publica>"

# Chave PÚBLICA (anon/publishable) do Supabase — OPCIONAL.
# Usada só pelo navegador no upload direto da videoaula, porque o gateway do
# Supabase exige o header `apikey` (quem autoriza de fato é o token da URL
# assinada). É pública por design e protegida por RLS — não é segredo.
# Sem definir, o código usa a chave embutida em src/lib/supabase-storage.ts
# (PUBLISHABLE_KEY_FALLBACK). Defina uma destas para trocar de projeto Supabase
# ou rotacionar a chave sem alterar código. SUPABASE_ANON_KEY tem precedência.
# SUPABASE_ANON_KEY="<anon-key-publica>"
# SUPABASE_PUBLISHABLE_KEY="<publishable-key-publica>"
