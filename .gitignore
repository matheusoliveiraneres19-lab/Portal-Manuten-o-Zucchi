# Dependencies
/node_modules
/.pnp
.pnp.js

# Next.js
/.next/
# distDir alternativo via NEXT_DIST_DIR (ver next.config.mjs)
/.next-*/
/out/
next-env.d.ts

# Production build
/build

# Misc
.DS_Store
*.pem
Thumbs.db

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local env files (NUNCA versionar segredos)
.env
.env*.local

# TypeScript build info
*.tsbuildinfo

# Prisma - banco de desenvolvimento (recriado via migrate + seed)
/prisma/dev.db
/prisma/dev.db-journal
*.db
*.db-journal

# Logs internos / temporarios
/scripts/.start.log
/scripts/.start.err.log

# Dados de importacao (planilhas locais) - manter apenas a estrutura de pastas
/imports/**/*.xlsx
/imports/**/*.xls
/imports/**/*.csv

# Backups de linhas removidas em migracao (dados de negocio - nunca versionar)
/imports/**/backups/

# Editor
.vscode/*
!.vscode/extensions.json
.idea

# Configuracoes locais do Claude Code (por usuario)
.claude/settings.local.json

# Capturas do portal para o video Remotion (regeneraveis: npm run capture)
/public/captures

# Capturas de verificacao/depuracao (PNGs pesados, regeneraveis). Sem esta linha,
# um `git add .` versionaria dezenas de MB de screenshots.
/.shots/

# Local Vercel folder
.vercel

# Netlify (residual - o deploy oficial do portal e na Vercel)
/.netlify/
