generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  GESTOR
  TECNICO
  COMPRAS
  VISUALIZADOR
}

enum UserStatus {
  ATIVO
  INATIVO
}

enum Criticality {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum EquipmentStatus {
  OPERANDO
  EM_MANUTENCAO
  PARADO
  INATIVO
}

enum MaintenanceType {
  CORRETIVA
  PREVENTIVA
  PREDITIVA
  MELHORIA
  INSPECAO
}

enum MaintenanceArea {
  MECANICA
  ELETRICA
  LUBRIFICACAO
  PCM
  OPERACIONAL
}

enum ServiceOrderStatus {
  ABERTA
  LIBERADA
  EM_ANDAMENTO
  AGUARDANDO_MATERIAL
  FECHADA
  CANCELADA
}

enum Priority {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum PurchaseStatus {
  SOLICITADA
  EM_COTACAO
  APROVADA
  COMPRADA
  ENTREGUE
  ATRASADA
  CANCELADA
}

enum MaterialMovementType {
  ENTRADA
  SAIDA
  AJUSTE
}

/// Natureza da compra a partir do Grupo Comp (Y01 = normal, Y04 = regularização).
enum PurchaseType {
  NORMAL
  REGULARIZACAO
  OUTROS
}

/// Natureza do item comprado (material físico ou serviço/locação/mão de obra).
enum ItemNature {
  MATERIAL
  SERVICO
}

/// Status operacional canônico de uma linha de compra (regras do HTML
/// acompanhamento_compras_v3). Classificação ÚNICA e mutuamente exclusiva,
/// derivada por classifyPurchaseRecord() na importação. Precedência:
/// BLOQUEADO > SERVICO > REGULARIZACAO(Y04) > baldes Y01.
enum PurchaseOperationalStatus {
  PENDENTE_COMPRA
  COMPRADO
  ATRASADO
  ENTREGUE
  REGULARIZACAO
  SERVICO
  IGNORADO
}

/// Origem do registro de compra importado.
enum PurchaseRecordSource {
  EXCEL
  SAP
  MANUAL
}

enum LubricantMovementType {
  COMPRA
  CONSUMO
  AJUSTE
}

/// Classificação derivada do sinal/tipo de movimento na planilha SAP/Fiori.
enum LubricantMovementCategory {
  ENTRADA
  SAIDA
  ESTOQUE_INICIAL
  AJUSTE
}

enum AlertType {
  QUEBRA_RECORRENTE
  COMPRA_ATRASADA
  ESTOQUE_BAIXO
  OS_ATRASADA
  HORAS_ABAIXO_META
  LUBRIFICANTE_BAIXO
  TEMPERATURA
  VIBRACAO
  PRESSAO
  EQUIPAMENTO_PARADO
}

enum AlertStatus {
  ABERTO
  EM_ANALISE
  RESOLVIDO
  CANCELADO
}

enum ProcedureCategory {
  MECANICA
  ELETRICA
  LUBRIFICACAO
  SEGURANCA
  PCM
  OPERACIONAL
  OUTROS
}

enum ImportType {
  ORDENS_SERVICO
  COMPRAS
  MATERIAIS
  LUBRIFICANTES
  HORAS_APONTADAS
  EQUIPAMENTOS
  PROCEDIMENTOS
  PC_FACTORY
}

enum ImportStatus {
  SUCESSO
  PARCIAL
  ERRO
  EM_PROCESSAMENTO
}

enum DataSource {
  MANUAL
  SAP
  EXCEL
  SISTEMA
}

/// Classificação gerencial do "Nome Status Recurso" do PC-Factory.
/// O valor textual original é preservado em PcFactoryRecord.statusRaw (auditoria);
/// esta categoria deriva dele por match EXATO (ver pc-factory-normalizer.ts).
enum PcFactoryStatusCategory {
  MANUTENCAO
  PRODUCAO
  SETUP
  PARADA_PERDA
  OPERACIONAL
  EXCLUIR_TEMPO_PLANEJADO
  OUTROS
}

/// Origem do registro de PC-Factory importado.
enum PcFactorySource {
  EXCEL
  PC_FACTORY
  MANUAL
}

model User {
  id           String      @id @default(cuid())
  name         String
  login        String      @unique
  email        String?     @unique
  /// Use bcrypt ou algoritmo equivalente antes de gravar senhas em producao.
  passwordHash String?
  role         Role        @default(VISUALIZADOR)
  status       UserStatus  @default(ATIVO)
  position     String?
  sector       String?
  lastAccess   DateTime?
  /// Primeiro acesso: quando true, o usuário é obrigado a trocar a senha temporária
  /// antes de acessar o portal (não entra no dashboard até redefinir a senha).
  mustChangePassword         Boolean   @default(false)
  /// Auditoria do ciclo de vida da senha (sem nunca armazenar a senha em texto puro).
  passwordChangedAt          DateTime?
  lastLoginAt                DateTime?
  temporaryPasswordCreatedAt DateTime?
  temporaryPasswordExpiresAt DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  timeEntries  TimeEntry[]

  @@index([name])
  @@index([login])
  @@index([role])
  @@index([status])
}

model Equipment {
  id                String             @id @default(cuid())
  name              String
  code              String             @unique
  sector            String?
  location          String?
  manufacturer      String?
  model             String?
  status            EquipmentStatus    @default(OPERANDO)
  criticality       Criticality        @default(MEDIA)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  serviceOrders     ServiceOrder[]
  alerts            Alert[]
  purchases         Purchase[]
  materialMovements MaterialMovement[]

  @@index([code])
  @@index([name])
  @@index([status])
  @@index([criticality])
}

model ServiceOrder {
  id                 String             @id @default(cuid())
  osNumber           String
  title              String
  description        String?
  status             ServiceOrderStatus @default(ABERTA)
  statusSapRaw       String?
  type               MaintenanceType?
  area               MaintenanceArea?
  priority           Priority?          @default(MEDIA)
  responsible        String?
  responsibleName    String?
  responsibleId      String?
  equipmentId        String?
  equipment          Equipment?         @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  equipmentCode      String?
  equipmentName      String?
  technicalObjectRaw String?
  planningGroup      String?
  planningGroupCode  String?
  /// Tipo de atividade de manutenção do SAP/Fiori (texto cru, ex.: "Corretiva", "PM02").
  /// Normalizado para análise por `resolvePlanningActivityType` (utils/service-order-planning).
  planningActivityType String?
  /// Tipo de manutenção do SAP (texto cru), quando a coluna existir no export.
  maintenanceType    String?
  /// Tipo de ordem do SAP (ex.: "ZM01"), quando a coluna existir no export.
  orderType          String?
  openedAt           DateTime?
  closedAt           DateTime?
  workedHours        Float?
  downtimeHours      Float?
  operation          String?
  operationCode      String?
  failureCause       String?
  solution           String?
  source             DataSource         @default(MANUAL)
  importBatch        String?
  dataQualityIssue   String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  timeEntries        TimeEntry[]

  @@unique([osNumber, operationCode])
  @@index([osNumber])
  @@index([status])
  @@index([type])
  @@index([area])
  @@index([openedAt])
  @@index([responsibleName])
  @@index([equipmentId])
  @@index([equipmentCode])
  @@index([planningGroup])
  @@index([planningActivityType])
}

model Purchase {
  id           String         @id @default(cuid())
  item         String
  materialCode String?
  supplier     String?
  status       PurchaseStatus @default(SOLICITADA)
  priority     Priority       @default(MEDIA)
  quantity     Float?
  unitValue    Float?
  totalValue   Float?
  requestDate  DateTime?
  purchaseDate DateTime?
  expectedDate DateTime?
  requester    String?
  equipmentId  String?
  equipment    Equipment?     @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status])
  @@index([materialCode])
  @@index([supplier])
  @@index([expectedDate])
  @@index([equipmentId])
}

/// Registro de compra rico importado da planilha SAP/Fiori (BASE DE DADOS PORTAL COMPRAS).
/// Fonte ÚNICA das páginas Compras Pendentes/Realizadas e dos indicadores de compras.
model PurchaseRecord {
  id                     String               @id @default(cuid())
  /// Pedido de Compra (vazio = requisição sem pedido criado).
  purchaseOrderNumber    String?
  /// Requisição e nível da requisição.
  requisitionNumber      String?
  requisitionLevel       String?
  /// Fornecedor (código + descrição).
  supplierCode           String?
  supplierName           String?
  /// Material (código) e texto breve do pedido.
  materialCode           String?
  itemDescription        String
  quantity               Float?
  /// Quantidade ainda pendente de recebimento (coluna "Quant Pendente").
  pendingQuantity        Float?
  unit                   String?
  /// Datas do processo.
  requisitionDate        DateTime?
  purchaseOrderDate      DateTime?
  expectedDeliveryDate   DateTime?
  receiptDate            DateTime?
  migoDate               DateTime?
  miroDate               DateTime?
  /// Documentos SAP.
  receiptNumber          String?
  migoNumber             String?
  miroNumber             String?
  /// Valores (unitário e total, bruto e líquido).
  grossPrice             Float?
  netPrice               Float?
  grossTotal             Float?
  netTotal               Float?
  /// Categoria de mercadoria (Grupo Merc).
  goodsGroupCode         String?
  goodsGroupDescription  String?
  requester              String?
  /// Grupo de compras (Y01/Y04) e código de eliminação.
  purchasingGroup        String?
  deletionCode           String?
  /// Classificações derivadas.
  purchaseType           PurchaseType         @default(OUTROS)
  itemNature             ItemNature           @default(MATERIAL)
  /// Status operacional canônico, derivado por classifyPurchaseRecord.
  operationalStatus      PurchaseOperationalStatus @default(IGNORADO)
  /// Serviço (Grupo Comp contém Y0008) — separado dos KPIs Y01.
  isService              Boolean              @default(false)
  /// Item bloqueado (termo "bloq") — auditoria; fora dos KPIs principais.
  isBlocked              Boolean              @default(false)
  /// Frete ("frete" na descrição/grupo) — fora do relatório.
  isFreight              Boolean              @default(false)
  /// Fornecedor eliminado (Auren, Newcom, ...) — fora do relatório.
  isEliminatedSupplier   Boolean              @default(false)
  /// CódElim = "L" (marcado para eliminação) — fora do relatório.
  isDeletionExcluded     Boolean              @default(false)
  hasPurchaseOrder       Boolean              @default(false)
  hasMigo                Boolean              @default(false)
  hasMiro                Boolean              @default(false)
  isReceiptCompleted     Boolean              @default(false)
  /// Recbconcl = "X" (recebimento concluído). Base do "entregue".
  isReceiptConfirmed     Boolean              @default(false)
  /// Atraso em aberto (previsão vencida, ainda sem recebimento/MIGO).
  isLateOpen             Boolean              @default(false)
  /// Recebido com atraso (recebimento/MIGO após a previsão).
  isLateReceived         Boolean              @default(false)
  delayDays              Int?
  /// Tempos do processo (em dias).
  requisitionToOrderDays Int?
  orderToReceiptDays     Int?
  migoToMiroDays         Int?
  totalProcessDays       Int?
  /// Itens bloqueados/ignorados na análise (mantidos só para auditoria).
  ignored                Boolean              @default(false)
  ignoredReason          String?
  source                 PurchaseRecordSource @default(EXCEL)
  importBatch            String?
  /// Chave de deduplicação na reimportação.
  technicalKey           String               @unique
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@index([purchaseOrderNumber])
  @@index([requisitionNumber])
  @@index([supplierName])
  @@index([materialCode])
  @@index([goodsGroupCode])
  @@index([purchaseType])
  @@index([itemNature])
  @@index([operationalStatus])
  @@index([isService])
  @@index([isBlocked])
  @@index([isFreight])
  @@index([isEliminatedSupplier])
  @@index([isDeletionExcluded])
  @@index([isReceiptConfirmed])
  @@index([purchaseOrderDate])
  @@index([requisitionDate])
  @@index([expectedDeliveryDate])
  @@index([receiptDate])
  @@index([hasPurchaseOrder])
  @@index([isReceiptCompleted])
  @@index([isLateOpen])
  @@index([ignored])
}

model Material {
  id           String             @id @default(cuid())
  name         String
  code         String             @unique
  category     String?
  unit         String
  currentStock Float              @default(0)
  minimumStock Float              @default(0)
  averageValue Float?
  criticality  Criticality        @default(MEDIA)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  movements    MaterialMovement[]

  @@index([code])
  @@index([name])
  @@index([category])
  @@index([criticality])
}

model MaterialMovement {
  id           String               @id @default(cuid())
  materialId   String
  material     Material             @relation(fields: [materialId], references: [id], onDelete: Restrict)
  equipmentId  String?
  equipment    Equipment?           @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  type         MaterialMovementType
  quantity     Float
  unitValue    Float?
  totalValue   Float?
  movementDate DateTime
  responsible  String?
  observation  String?
  createdAt    DateTime             @default(now())

  @@index([materialId])
  @@index([equipmentId])
  @@index([type])
  @@index([movementDate])
}

model Lubricant {
  id                  String                        @id @default(cuid())
  name                String
  code                String                        @unique
  description         String?
  /// Categoria/tipo do material (ex.: Hidráulico, Graxa). Mantém o antigo "type".
  category            String?
  type                String?
  unit                String
  currentStock        Float                         @default(0)
  minimumStock        Float                         @default(0)
  technicalSheetUrl   String?
  applicationNotes    String?
  active              Boolean                       @default(true)
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  movements           LubricantMovement[]
  machineApplications LubricantMachineApplication[]

  @@index([code])
  @@index([name])
  @@index([active])
}

/// Máquina/equipamento onde um lubrificante é aplicado (cadastro manual).
model LubricantMachineApplication {
  id               String    @id @default(cuid())
  lubricantId      String
  lubricant        Lubricant @relation(fields: [lubricantId], references: [id], onDelete: Cascade)
  equipmentId      String?
  equipmentCode    String?
  equipmentName    String
  applicationPoint String?
  recommendation   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([lubricantId])
  @@index([equipmentId])
  @@index([equipmentCode])
}

/// Movimentação de lubrificante/material importada da planilha SAP/Fiori.
model LubricantMovement {
  id                  String                    @id @default(cuid())
  lubricantId         String
  lubricant           Lubricant                 @relation(fields: [lubricantId], references: [id], onDelete: Restrict)
  materialCode        String
  materialDescription String
  center              String?
  companyName         String?
  storageLocation     String?
  movementTypeCode    String?
  movementTypeText    String?
  movementCategory    LubricantMovementCategory
  movementDate        DateTime
  movementTime        String?
  /// Quantidade com o sinal original da planilha (negativo = saída).
  quantity            Float
  /// Quantidade sempre positiva (para somatórios de consumo/entrada).
  absoluteQuantity    Float
  unit                String
  source              DataSource                @default(EXCEL)
  importBatch         String?
  /// Chave de deduplicação da movimentação na reimportação.
  technicalKey        String?                   @unique
  createdAt           DateTime                  @default(now())

  @@index([lubricantId])
  @@index([materialCode])
  @@index([movementDate])
  @@index([movementCategory])
  @@index([technicalKey])
}

model Alert {
  id          String      @id @default(cuid())
  title       String
  description String
  type        AlertType
  severity    Priority    @default(MEDIA)
  status      AlertStatus @default(ABERTO)
  equipmentId String?
  equipment   Equipment?  @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([type])
  @@index([severity])
  @@index([status])
  @@index([equipmentId])
}

model TimeEntry {
  id             String        @id @default(cuid())
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName       String
  serviceOrderId String?
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)
  osNumber       String?
  workDate       DateTime
  hours          Float
  weeklyGoal     Float?
  monthlyGoal    Float?
  observation    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([userName])
  @@index([osNumber])
  @@index([workDate])
  @@index([serviceOrderId])
}

enum CollaboratorArea {
  MECANICA
  ELETRICA
  AUTOMACAO
  OUTROS
}

enum CollaboratorStatus {
  ATIVO
  FERIAS
  AFASTADO
  DESLIGADO
}

/// Situação de uma ferramenta sob responsabilidade do colaborador.
enum ToolStatus {
  EM_USO
  DEVOLVIDA
}

/// Natureza do anexo de um colaborador (ETAPA 3).
enum AttachmentKind {
  EPI_FICHA
  TERMO_FERRAMENTA
  OUTRO
}

/// Cadastro de colaboradores da manutenção (módulo Equipe e Horas).
/// `nameKey` é o nome normalizado (minúsculo, sem acento) para casar com
/// TimeEntry.userName nas análises de banco de horas.
model Collaborator {
  id            String             @id @default(cuid())
  matricula     String             @unique
  name          String
  nameKey       String
  role          String?
  area          CollaboratorArea   @default(OUTROS)
  shift         String?
  monthlyGoal   Float              @default(220)
  status        CollaboratorStatus @default(ATIVO)
  admissionDate DateTime?
  /// Início das próximas férias (editável por ADMIN/GESTOR).
  vacationStartDate      DateTime?
  /// Início do período aquisitivo de férias (default: data de admissão).
  acquisitionPeriodStart DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  epiItems      EpiItem[]
  toolItems     ToolItem[]
  attachments   Attachment[]

  @@index([matricula])
  @@index([nameKey])
  @@index([status])
  @@index([area])
}

/// EPI entregue ao colaborador, com CA e validade (ETAPA 3).
model EpiItem {
  id             String       @id @default(cuid())
  collaboratorId String
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  name           String
  /// Número do Certificado de Aprovação (CA) do EPI.
  caNumber       String
  /// Validade do CA — base do status derivado (Válido / a vencer / vencido).
  caValidUntil   DateTime
  deliveredAt    DateTime?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([collaboratorId])
  @@index([caValidUntil])
}

/// Ferramenta sob responsabilidade do colaborador (ETAPA 3).
model ToolItem {
  id             String       @id @default(cuid())
  collaboratorId String
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  name           String
  status         ToolStatus   @default(EM_USO)
  assignedAt     DateTime?
  returnedAt     DateTime?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([collaboratorId])
  @@index([status])
}

/// Metadado de anexo (o arquivo fica no Supabase Storage, NÃO no banco) (ETAPA 3).
model Attachment {
  id             String         @id @default(cuid())
  collaboratorId String
  collaborator   Collaborator   @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  kind           AttachmentKind @default(OUTRO)
  fileName       String
  /// Caminho do objeto dentro do bucket privado (sem URL pública).
  storagePath    String
  contentType    String
  sizeBytes      Int
  uploadedAt     DateTime       @default(now())

  @@index([collaboratorId])
  @@index([kind])
}

model Procedure {
  id          String            @id @default(cuid())
  title       String
  description String?
  category    ProcedureCategory @default(OUTROS)
  version     String            @default("1.0")
  fileUrl     String?
  active      Boolean           @default(true)
  responsible String?

  /// Central de Procedimentos (fase 02) — campos aditivos. categoryName guarda a
  /// categoria de exibição (8 categorias da Central); o enum `category` continua para
  /// compatibilidade com o KPI "Procedimentos Ativos" e dados legados.
  slug             String?   @unique
  categoryName     String?
  summary          String?
  objective        String?
  whenToUse        String?
  content          String?
  commonMistakes   String?
  level            String    @default("Básico")
  estimatedMinutes Int?
  targetAudience   String?
  status           String    @default("Publicado")
  tags             String?
  isFeatured       Boolean   @default(false)
  isOnboarding     Boolean   @default(false)
  /// Ordem na trilha "Primeiros passos para funcionário novo" (fase 03).
  onboardingOrder  Int?
  viewCount        Int       @default(0)
  lastReviewedAt   DateTime?
  nextReviewAt     DateTime?

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  attachments       ProcedureAttachment[]
  favorites         ProcedureFavorite[]
  readConfirmations ProcedureReadConfirmation[]

  @@index([category])
  @@index([active])
  @@index([title])
  @@index([status])
  @@index([categoryName])
  @@index([isFeatured])
  @@index([isOnboarding])
}

/// Material de apoio de um procedimento (fase 03). Arquivos ficam no Supabase Storage
/// (bucket privado); `fileUrl` guarda o caminho do objeto (uploads) ou a URL externa
/// (fileType = "link", ex.: vídeo do YouTube). Nada é salvo no repositório.
model ProcedureAttachment {
  id          String    @id @default(cuid())
  procedureId String
  fileName    String
  fileType    String
  fileUrl     String
  fileSize    Int?
  description String?
  createdAt   DateTime  @default(now())
  procedure   Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@index([procedureId])
}

/// Favorito de um procedimento por usuário (fase 03).
model ProcedureFavorite {
  id          String    @id @default(cuid())
  userId      String
  procedureId String
  createdAt   DateTime  @default(now())
  procedure   Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@unique([userId, procedureId])
  @@index([userId])
  @@index([procedureId])
}

/// Registro de leitura ("Li e estou ciente") de um procedimento por usuário (fase 03).
model ProcedureReadConfirmation {
  id          String    @id @default(cuid())
  userId      String
  procedureId String
  confirmedAt DateTime  @default(now())
  procedure   Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@unique([userId, procedureId])
  @@index([userId])
  @@index([procedureId])
}

/// Registro operacional importado do PC-Factory (status/tempo de máquinas e linhas).
/// Fonte ÚNICA da página /dashboard/pc-factory e dos indicadores de produção.
model PcFactoryRecord {
  id                 String                  @id @default(cuid())
  /// Código do recurso/máquina no PC-Factory.
  resourceCode       String?
  /// Nome do recurso/máquina (obrigatório — identidade do registro).
  resourceName       String
  /// Linha de produção e setor onde o recurso opera.
  productionLine     String?
  /// Grupo gerencial do portal (ex.: "Indústria Granito", "Indústria Mármore").
  groupPortal        String?
  sector             String?
  /// Código do status no PC-Factory ("G0015.RCODSTATUS"). Fonte do grupo gerencial.
  statusCode         String?
  /// Valor exato de "Nome Status Recurso" vindo da planilha (auditoria, nunca substituído).
  statusRaw          String?
  /// Chave canônica do status real (UPPER_SNAKE), p/ agrupar e colorir o gráfico de
  /// distribuição por status. Derivada de statusRaw (ver normalizePcFactoryStatusKey).
  statusKey          String?
  /// Cor do status LIDA DA PLANILHA na importação (#RRGGBB): coluna de cor explícita ou
  /// preenchimento da célula. Nulo quando a planilha não trouxe cor (aí usa-se fallback).
  statusColorHex     String?
  /// Detalhamento do status (campo livre da planilha).
  statusDetails      String?
  /// Classificação gerencial derivada de statusRaw por match exato.
  statusCategory     PcFactoryStatusCategory @default(OUTROS)
  /// Grupo da Tabela Gerencial do PC-Factory (PADRAO_SISTEMA | SETUP | MANUTENCAO |
  /// OPERACIONAL | MATERIAIS | EXTERNO), derivado de statusCode. String para evitar
  /// CREATE TYPE na migration Supabase. Ver classifyManagementGroup().
  managementGroup    String?
  /// Valor cru de "classificationPcFactoryRef" do CSV histórico (Produção | Parada
  /// Planejada I | Parada Planejada II | Parada Não Planejada | Tempo Fora de Turno).
  /// Auditoria + última prioridade em classifyAvailabilityBucket(). Nulo nos layouts XLSX.
  classificationRef  String?
  /// Bucket oficial de disponibilidade (PRODUCAO | PARADA_PLANEJADA |
  /// PARADA_NAO_PLANEJADA | FORA_DE_TURNO | RECURSO_NAO_PROGRAMADO | NAO_APONTADO),
  /// derivado por statusCode > status > classificationRef. String para evitar CREATE TYPE
  /// na migration Supabase. Base do cálculo oficial — ver classifyAvailabilityBucket().
  availabilityBucket String?
  /// Tipo de manutenção derivado (MECANICA | ELETRICA | AUTOMACAO | PLANEJADA | TERCEIROS | AGUARDANDO), ou null.
  maintenanceType    String?
  /// Entra no KPI de manutenção (os 4 status de manutenção). Derivado de statusRaw.
  isMaintenanceKpi   Boolean                 @default(false)
  /// Sai do tempo planejado (Fora de Turno / Recurso Não Programado). Derivado.
  excludePlannedTime Boolean                 @default(false)
  /// Reduz a disponibilidade estimada (manutenção + parada/perda + setup). Derivado.
  isDowntimeForAvailability Boolean           @default(false)
  /// Janela do evento.
  startDateTime      DateTime?
  endDateTime        DateTime?
  /// Duração do evento (sempre positiva), em minutos e horas — "Tempo Decorrido".
  durationMinutes    Float
  durationHours      Float
  /// "Tempo Decorrido Real" (base principal dos KPIs: MTBF/MTTR/MTTA/disponibilidade).
  /// Nulo quando a planilha não trouxe a coluna — nesse caso usa-se durationHours como fallback.
  realDurationMinutes Float?
  realDurationHours   Float?
  /// Responsáveis e operador do evento.
  initialResponsible String?
  finalResponsible   String?
  operatorName       String?
  /// Ordem de produção / operação / produto associado ao evento.
  orderNumber        String?
  operationCode      String?
  operationName      String?
  productCode        String?
  productDescription String?
  shift              String?
  /// Observação/comentários e causa raiz informados na planilha.
  observation        String?
  rootCause          String?
  /// Marcação de problema de qualidade de dados detectado na importação.
  dataQualityIssue   String?
  source             PcFactorySource         @default(EXCEL)
  importBatch        String?
  /// Chave de deduplicação na reimportação.
  technicalKey       String?                 @unique
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([resourceName])
  @@index([resourceCode])
  @@index([productionLine])
  @@index([groupPortal])
  @@index([sector])
  @@index([statusCategory])
  @@index([statusKey])
  @@index([availabilityBucket])
  @@index([maintenanceType])
  @@index([startDateTime])
  @@index([endDateTime])
  @@index([importBatch])
}

model ImportHistory {
  id           String       @id @default(cuid())
  type         ImportType
  fileName     String
  importedBy   String?
  totalRows    Int          @default(0)
  createdRows  Int          @default(0)
  updatedRows  Int          @default(0)
  errorRows    Int          @default(0)
  status       ImportStatus
  errorMessage String?
  createdAt    DateTime     @default(now())

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

/// Trilha de auditoria administrativa do portal (fase 03). Registra ações sensíveis
/// (login, troca de senha, CRUD de usuários/procedimentos, alteração de regras,
/// importação de planilha). `action` e `module` são String (sem enums) de propósito,
/// para evitar CREATE TYPE em migrations Supabase e permitir novas ações sem migração.
/// NUNCA armazenar dados sensíveis em `details` (senha, hash, token, connection string).
model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  userName    String?
  action      String
  module      String
  entityId    String?
  entityName  String?
  details     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([module])
  @@index([userId])
  @@index([createdAt])
}

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Hierarquia de LOCAIS DE INSTALAÇÃO (SAP PM) importada da planilha
/// "Local de Instalação.xlsx". Camada OPCIONAL de enriquecimento da aba
/// Equipamentos Críticos: fornece a descrição oficial, o centro de custo, a
/// família e a RAIZ autoritativa de cada TAG. Quando ausente/vazia, a resolução
/// da raiz é feita pelo padrão estrutural do TAG (functional-location-hierarchy).
/// Nunca contém dados sensíveis nem substitui as Ordens de Manutenção (fonte
/// oficial dos indicadores continua sendo ServiceOrder).
model FunctionalLocation {
  id                    String   @id @default(cuid())
  /// TAG do local de instalação (normalizado em maiúsculas). Chave natural.
  tag                   String   @unique
  description           String
  costCenter            String?
  costCenterDescription String?
  /// TAG do local pai (um nível acima na hierarquia).
  parentTag             String?
  /// TAG do equipamento RAIZ (máquina principal) a que este local pertence.
  rootTag               String?
  rootDescription       String?
  /// Setor/galpão derivado do TAG (ex.: SR-G07).
  area                  String?
  /// Código da família de equipamento (ex.: MF, PZ, LR).
  equipmentFamily       String?
  /// true quando o TAG é o próprio equipamento raiz (máquina principal).
  isRootEquipment       Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([rootTag])
  @@index([parentTag])
  @@index([equipmentFamily])
  @@index([isRootEquipment])
}

/// Parâmetros administrativos editáveis do portal (metas, regras, prefixos…).
/// Genérico por (category, key); `value` é Json para suportar número, texto,
/// booleano, lista de palavras e seleção. Sempre há fallback no código.
model PortalSetting {
  id          String   @id @default(cuid())
  category    String
  key         String
  label       String
  description String?
  value       Json
  valueType   String
  isEditable  Boolean  @default(true)
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([category, key])
  @@index([category])
}
